{
  "name": "@orbital/dock",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop control center application for the Orbital ecosystem.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@orbital/bridge": "workspace:*",
    "@orbital/pulse": "workspace:*",
    "@orbital/sentinel": "workspace:*"
  }
}
