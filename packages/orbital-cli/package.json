{
  "name": "@orbital/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command line interface for the Orbital ecosystem.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "orbital": "./dist/cli.js",
    "orbital-dock": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "@orbital/forge": "workspace:*",
    "@orbital/sentinel": "workspace:*",
    "@orbital/synapse": "workspace:*",
    "@orbital/vault": "workspace:*",
    "picocolors": "^1.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
